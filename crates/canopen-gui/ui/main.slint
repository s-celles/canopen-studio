export component MainWindow inherits Window {
    width: 600px;
    height: 400px;
    title: "CANopen Studio - Real-Time Dashboard";

    in-out property <int> rpm: 0;
    in-out property <string> nmt_state: "Pre-Operational";

    VerticalLayout {
        padding: 40px;
        spacing: 30px;

        Text {
            text: "CANopen Node 1 (SEVCON Gen4)";
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Rectangle {
            background: #1e1e2e;
            border-radius: 12px;
            
            VerticalLayout {
                padding: 30px;
                alignment: center;
                
                Text {
                    text: root.rpm + " RPM";
                    font-size: 64px;
                    font-weight: 800;
                    color: #a6e3a1;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "Motor Speed (0x606C)";
                    font-size: 16px;
                    color: #a6adc8;
                    horizontal-alignment: center;
                }
            }
        }

        Rectangle {
            background: #1e1e2e;
            border-radius: 12px;
            height: 80px;

            HorizontalLayout {
                padding: 20px;
                alignment: center;
                spacing: 15px;

                Text {
                    text: "NMT State:";
                    font-size: 20px;
                    color: #cdd6f4;
                }
                Text {
                    text: root.nmt_state;
                    font-size: 20px;
                    font-weight: 700;
                    color: root.nmt_state == "Operational" ? #a6e3a1 : #f9e2af;
                }
            }
        }
    }
}
