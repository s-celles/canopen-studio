import { Button, CheckBox, ComboBox, LineEdit, TabWidget, StandardTableView, Palette, TextEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    width: 1150px;
    height: 800px;
    title: "CAN & CANopen Studio - Universal Protocol Analyzer & Transmit Station";
    background: Palette.background;

    in-out property <int> rpm: 0;
    in-out property <int> torque: 0;
    in-out property <int> temp_inv: 0;
    in-out property <int> temp_motor: 0;
    in-out property <string> nmt_state: "Pre-Operational";
    in-out property <int> trace_count: 0;
    
    in-out property <string> connection_status: "Connected: virtual_bus";
    in-out property <string> bus_rate: "0 msgs/s";
    in-out property <int> total_rx: 0;
    in-out property <int> active_nodes: 0;
    
    in-out property <string> plot_path_b0: "";
    in-out property <string> plot_path_b1: "";
    
    in-out property <string> trace_text;
    in-out property <[[StandardListViewItem]]> nodes_model: [
        [ { text: "Node 1" }, { text: "Operational" }, { text: "0.0s ago" }, { text: "HEARTBEAT, TPDO" } ],
        [ { text: "Node 2" }, { text: "Pre-Operational" }, { text: "1.0s ago" }, { text: "HEARTBEAT" } ]
    ];

    VerticalLayout {
        // TOP BAR
        Rectangle {
            height: 50px;
            background: Palette.control-background;
            border-color: Palette.border;
            border-width: 1px;
            
            HorizontalLayout {
                padding: 10px;
                spacing: 10px;
                alignment: start;
                
                Text { text: "Interface:"; vertical-alignment: center; color: Palette.foreground; }
                ComboBox { model: ["Virtual Simulator", "UDP Multicast", "SocketCAN"]; current-index: 0; width: 140px; }
                
                Text { text: "Channel:"; vertical-alignment: center; color: Palette.foreground; }
                ComboBox { model: ["127.0.0.1:1750", "224.0.0.1:1750", "can0"]; current-index: 0; width: 130px; }
                
                Text { text: "Bitrate:"; vertical-alignment: center; color: Palette.foreground; }
                ComboBox { model: ["500000", "250000", "1000000"]; current-index: 0; width: 90px; }

                Text { text: "Profile:"; vertical-alignment: center; color: Palette.foreground; }
                ComboBox { model: ["All / Auto", "CiA 402", "SEVCON"]; current-index: 0; width: 100px; }

                Button { text: "Disconnect"; }
                
                Rectangle { horizontal-stretch: 1; }
                
                Text {
                    text: root.connection_status;
                    color: root.connection_status != "Disconnected" ? #228b22 : #ff0000;
                    vertical-alignment: center;
                }
                
                Button { text: "i About"; }
            }
        }
        
        TabWidget {
            Tab {
                title: "🌐 Network & Dashboard";
                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;
                    
                    // Bus Statistics
                    Rectangle {
                        height: 35px;
                        background: Palette.control-background;
                        border-color: Palette.border;
                        border-width: 1px;
                        HorizontalLayout {
                            padding-left: 15px;
                            padding-right: 15px;
                            spacing: 30px;
                            alignment: start;
                            Text { text: "Bus Rate: " + root.bus_rate; color: #0066cc; font-weight: 700; vertical-alignment: center; }
                            Text { text: "Total Received: " + root.total_rx; color: Palette.foreground; vertical-alignment: center; }
                            Text { text: "Total Transmitted: 0"; color: Palette.foreground; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "Active Nodes: " + root.active_nodes; color: #228b22; font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    
                    HorizontalLayout {
                        spacing: 10px;
                        
                        // Left: Discovered Nodes
                        VerticalLayout {
                            width: 500px;
                            Text { text: "Discovered CANopen Network Nodes (CiA 301)"; font-size: 13px; color: Palette.foreground; }
                            Rectangle { height: 5px; }
                            StandardTableView {
                                columns: [
                                    { title: "Node ID" },
                                    { title: "NMT State" },
                                    { title: "Last Seen" },
                                    { title: "Active Services" }
                                ];
                                rows: root.nodes_model;
                            }
                        }
                        
                        // Right: Dynamic Telemetry
                        VerticalLayout {
                            Text { text: "Dynamic Telemetry (CiA 402 / SEVCON)"; font-size: 13px; color: Palette.foreground; }
                            Rectangle { height: 5px; }
                            
                            GridLayout {
                                spacing: 15px;
                                
                                Rectangle {
                                    col: 0; row: 0;
                                    background: Palette.control-background;
                                    border-color: Palette.border;
                                    border-width: 1px;
                                    VerticalLayout {
                                        padding: 10px;
                                        Text { text: "Motor Speed (0x606C)"; font-size: 11px; color: Palette.foreground; }
                                        Text { text: root.rpm + " RPM"; font-size: 32px; font-weight: 700; color: #0078d7; horizontal-alignment: center; vertical-stretch: 1; vertical-alignment: center; }
                                        Text { text: "Max: 5000 RPM"; font-size: 11px; color: Palette.foreground; horizontal-alignment: center; }
                                    }
                                }
                                
                                Rectangle {
                                    col: 1; row: 0;
                                    background: Palette.control-background;
                                    border-color: Palette.border;
                                    border-width: 1px;
                                    VerticalLayout {
                                        padding: 10px;
                                        Text { text: "Target Torque / Status"; font-size: 11px; color: Palette.foreground; }
                                        Text { text: root.torque; font-size: 32px; font-weight: 700; color: #d9534f; horizontal-alignment: center; vertical-stretch: 1; vertical-alignment: center; }
                                        Text { text: "State: Operation Enabled"; font-size: 11px; color: Palette.foreground; horizontal-alignment: center; }
                                    }
                                }
                                
                                Rectangle {
                                    col: 0; row: 1;
                                    background: Palette.control-background;
                                    border-color: Palette.border;
                                    border-width: 1px;
                                    VerticalLayout {
                                        padding: 10px;
                                        Text { text: "Inverter / Heatsink Temp"; font-size: 11px; color: Palette.foreground; }
                                        Text { text: root.temp_inv + " °C"; font-size: 32px; font-weight: 700; color: #f0ad4e; horizontal-alignment: center; vertical-stretch: 1; vertical-alignment: center; }
                                    }
                                }
                                
                                Rectangle {
                                    col: 1; row: 1;
                                    background: Palette.control-background;
                                    border-color: Palette.border;
                                    border-width: 1px;
                                    VerticalLayout {
                                        padding: 10px;
                                        Text { text: "Motor Temperature"; font-size: 11px; color: Palette.foreground; }
                                        Text { text: root.temp_motor; font-size: 32px; font-weight: 700; color: #5cb85c; horizontal-alignment: center; vertical-stretch: 1; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Tab {
                title: "📈 Reverse Plotter";
                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;
                    
                    // Toolbar
                    Rectangle {
                        height: 40px;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            
                            Text { text: "Target Mode:"; vertical-alignment: center; color: Palette.foreground; }
                            ComboBox { model: ["CAN ID (Raw Bytes)", "Decoded Signal"]; current-index: 0; width: 150px; }
                            
                            Text { text: "Target ID / Signal:"; vertical-alignment: center; color: Palette.foreground; }
                            ComboBox { model: ["0x473"]; current-index: 0; width: 120px; }
                            
                            Text { text: "Format:"; vertical-alignment: center; color: Palette.foreground; }
                            ComboBox { model: ["All Bytes (B0..B7)"]; current-index: 0; width: 140px; }
                            
                            Button { text: "Pause Plot"; }
                            Button { text: "Clear"; }
                        }
                    }
                    
                    // Graph Area (Dark background like matplotlib dark_background, this should stay dark)
                    Rectangle {
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #444;
                        
                        VerticalLayout {
                            padding: 10px;
                            Text { text: "CAN ID: 0x473 (SEVCON TPDO5 (Actual Speed 0x606C & Max Speed))"; color: white; horizontal-alignment: center; }
                            Text { text: "Payload Bytes 0..7"; color: white; horizontal-alignment: center; font-size: 11px; }
                            
                            Rectangle {
                                clip: true;
                                Path { 
                                    width: 100%; height: 100%;
                                    viewbox-width: 800; viewbox-height: 300;
                                    commands: root.plot_path_b0; stroke: #00BFFF; stroke-width: 1.5px; 
                                }
                                Path { 
                                    width: 100%; height: 100%;
                                    viewbox-width: 800; viewbox-height: 300;
                                    commands: root.plot_path_b1; stroke: #32CD32; stroke-width: 1.5px; 
                                }
                                
                                // Y Axis (RPM)
                                Text { text: "4000 -"; color: #888; y: 10px; x: 10px; }
                                Text { text: "3000 -"; color: #888; y: parent.height * 0.25; x: 10px; }
                                Text { text: "2000 -"; color: #888; y: parent.height * 0.5; x: 10px; }
                                Text { text: "1000 -"; color: #888; y: parent.height * 0.75; x: 10px; }
                                Text { text: "   0 -"; color: #888; y: parent.height - 30px; x: 10px; }
                                
                                // X Axis (Time)
                                Text { text: "-30s"; color: #888; y: parent.height - 15px; x: 60px; }
                                Text { text: "-20s"; color: #888; y: parent.height - 15px; x: 60px + (parent.width - 80px) * 0.33; }
                                Text { text: "-10s"; color: #888; y: parent.height - 15px; x: 60px + (parent.width - 80px) * 0.66; }
                                Text { text: "0s"; color: #888; y: parent.height - 15px; x: parent.width - 20px; }
                                
                                Rectangle {
                                    x: 60px; y: 10px; width: 80px; height: 120px;
                                    background: #222; border-color: #555; border-width: 1px;
                                    VerticalLayout {
                                        padding: 5px; spacing: 2px;
                                        HorizontalLayout { spacing: 5px; alignment: start; Rectangle { width: 15px; height: 2px; background: #00BFFF; } Text { text: "B0"; color: white; font-size: 10px;} }
                                        HorizontalLayout { spacing: 5px; alignment: start; Rectangle { width: 15px; height: 2px; background: #32CD32; } Text { text: "B1"; color: white; font-size: 10px;} }
                                        HorizontalLayout { spacing: 5px; alignment: start; Rectangle { width: 15px; height: 2px; background: #DAA520; } Text { text: "B2"; color: white; font-size: 10px;} }
                                        HorizontalLayout { spacing: 5px; alignment: start; Rectangle { width: 15px; height: 2px; background: #FF4500; } Text { text: "B3"; color: white; font-size: 10px;} }
                                        HorizontalLayout { spacing: 5px; alignment: start; Rectangle { width: 15px; height: 2px; background: #9370DB; } Text { text: "B4"; color: white; font-size: 10px;} }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Tab { 
                title: "📋 Real-time Trace"; 
                VerticalLayout {
                    padding: 10px;
                    TextEdit {
                        text: root.trace_text;
                        read-only: true;
                        font-size: 12px;
                    }
                }
            }
            Tab { 
                title: "🚀 Transmit & Control"; 
                VerticalLayout {
                    padding: 20px; spacing: 15px; alignment: start;
                    Text { text: "Manual CAN Frame Transmission"; font-size: 16px; font-weight: 700; color: Palette.foreground; }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "CAN ID (Hex):"; vertical-alignment: center; color: Palette.foreground; }
                        LineEdit { text: "0x601"; width: 80px; }
                        Text { text: "Data (Hex):"; vertical-alignment: center; color: Palette.foreground; }
                        LineEdit { text: "40 00 10 00 00 00 00 00"; width: 200px; }
                        Button { text: "Send Frame"; primary: true; }
                    }
                    Rectangle { height: 1px; background: Palette.border; }
                    Text { text: "NMT Control (Network Management)"; font-size: 16px; font-weight: 700; color: Palette.foreground; }
                    HorizontalLayout {
                        spacing: 10px;
                        Button { text: "Start Node (0x01)"; }
                        Button { text: "Stop Node (0x02)"; }
                        Button { text: "Enter Pre-Op (0x80)"; }
                        Button { text: "Reset Node (0x81)"; }
                        Button { text: "Reset Comm (0x82)"; }
                    }
                }
            }
            Tab { title: "📖 SDO Object Dictionary"; Text { text: "Dictionary Explorer (Planned)"; color: Palette.foreground; horizontal-alignment: center; vertical-alignment: center; } }
            Tab { 
                title: "🩺 OBD-II Diagnostics"; 
                VerticalLayout {
                    padding: 10px; spacing: 10px; alignment: start;
                    
                    // Connection
                    Rectangle {
                        border-width: 1px; border-color: Palette.border; background: Palette.control-background;
                        VerticalLayout {
                            padding: 10px; spacing: 10px;
                            Text { text: "Diagnostic Link"; font-weight: 700; color: Palette.foreground; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Adapter:"; vertical-alignment: center; color: Palette.foreground; }
                                ComboBox { model: ["ELM327 — serial / Bluetooth SPP", "ELM327 — Wi-Fi / TCP", "Native CAN (ISO-TP over the connected bus)"]; current-index: 0; width: 220px; }
                                Text { text: "Port / Host:"; vertical-alignment: center; color: Palette.foreground; }
                                LineEdit { text: "/dev/ttyUSB0"; width: 120px; }
                                Text { text: "Baud:"; vertical-alignment: center; color: Palette.foreground; }
                                LineEdit { text: "38400"; width: 80px; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Protocol:"; vertical-alignment: center; color: Palette.foreground; }
                                ComboBox { model: ["0 — autodetect", "6 — ISO 15765-4 CAN 11-bit, 500 kbaud"]; current-index: 0; width: 220px; }
                                Text { text: "Profile:"; vertical-alignment: center; color: Palette.foreground; }
                                ComboBox { model: ["Auto"]; current-index: 0; width: 120px; }
                                Button { text: "🔌 Connect"; }
                            }
                            Text { text: "Not connected."; color: #a0a0a0; font-family: "monospace"; }
                        }
                    }

                    // Vehicle Identity
                    Rectangle {
                        border-width: 1px; border-color: Palette.border; background: Palette.control-background;
                        VerticalLayout {
                            padding: 10px;
                            Text { text: "Vehicle"; font-weight: 700; color: Palette.foreground; }
                            Text { text: "Connect to read the VIN, the ECUs and the profile the vehicle resolves to."; color: Palette.foreground; font-family: "monospace"; }
                        }
                    }

                    // Live Parameters
                    Rectangle {
                        border-width: 1px; border-color: Palette.border; background: Palette.control-background;
                        VerticalLayout {
                            padding: 10px; spacing: 10px;
                            Text { text: "Supported Parameters"; font-weight: 700; color: Palette.foreground; }
                            HorizontalLayout {
                                spacing: 10px;
                                Button { text: "🔍 Discover"; }
                                Button { text: "📊 Read All"; }
                                Button { text: "↻ Read Selected"; }
                            }
                            StandardTableView {
                                height: 180px;
                                columns: [
                                    { title: "PID", width: 70px },
                                    { title: "Parameter", width: 230px },
                                    { title: "Value", width: 110px },
                                    { title: "Unit", width: 70px },
                                ];
                                rows: [
                                    [ { text: "0C" }, { text: "Engine RPM" }, { text: "--" }, { text: "rpm" } ],
                                    [ { text: "0D" }, { text: "Vehicle Speed" }, { text: "--" }, { text: "km/h" } ],
                                ];
                            }
                        }
                    }
                }
            }
            Tab { title: "🔧 Hardware Diagnostics"; Text { text: "Hardware State & Errors (Planned)"; color: Palette.foreground; horizontal-alignment: center; vertical-alignment: center; } }
            Tab { title: "📚 CANopen Reference"; Text { text: "Documentation (Planned)"; color: Palette.foreground; horizontal-alignment: center; vertical-alignment: center; } }
        }
    }
}
